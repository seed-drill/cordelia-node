# Copy to deploy/relay/.env on the relay host and fill in.

# Which relay this host runs: relay1 or relay2.
RELAY=relay1

# What to deploy. Preferred: a release, pinned by version and by the sha256
# of its Linux binary (cordelia-linux-amd64.sha256 on the release page).
CORDELIA_SOURCE=release
CORDELIA_VERSION=
CORDELIA_SHA256=

# Before the first release exists: build from this checkout instead. Check
# out the agreed commit first and record it (`git rev-parse HEAD`).
# CORDELIA_SOURCE=build
